<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <block type="trade_definition" id="hl_pair_definition" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="hl_pair_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST" strategy_value="symbol">1HZ100V</field>
        <next>
          <block type="trade_definition_tradetype" id="hl_pair_trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST" strategy_value="tradetypecat">callput</field>
            <field name="TRADETYPE_LIST" strategy_value="tradetype">higherlower</field>
            <next>
              <block type="trade_definition_contracttype" id="hl_pair_contract_type" deletable="false" movable="false">
                <field name="TYPE_LIST" strategy_value="type">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="hl_pair_candle_interval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="hl_pair_restart_buy_sell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="hl_pair_restart_last_trade" deletable="false" movable="false">
                            <field name="RESTARTONERROR">FALSE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="hl_pair_options">
        <mutation has_first_barrier="true" has_second_barrier="true" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <field name="BARRIEROFFSETTYPE_LIST">+</field>
        <field name="SECONDBARRIEROFFSETTYPE_LIST">-</field>
        <value name="DURATION" strategy_value="duration">
          <shadow type="math_number_positive" id="hl_pair_duration">
            <field name="NUM">5</field>
          </shadow>
        </value>
        <value name="AMOUNT" strategy_value="stake">
          <shadow type="math_number_positive" id="hl_pair_stake">
            <field name="NUM">5</field>
          </shadow>
        </value>
        <value name="BARRIEROFFSET">
          <shadow type="math_number_positive" id="hl_pair_higher_offset">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="SECONDBARRIEROFFSET">
          <shadow type="math_number_positive" id="hl_pair_lower_offset">
            <field name="NUM">1</field>
          </shadow>
        </value>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="hl_pair_after_purchase" x="650" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="trade_again" id="hl_pair_trade_again"></block>
    </statement>
  </block>
  <block type="before_purchase" id="hl_pair_before_purchase" x="0" y="450">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="hl_pair_purchase">
        <field name="PURCHASE_LIST" strategy_value="purchase">both</field>
      </block>
    </statement>
  </block>
</xml>
